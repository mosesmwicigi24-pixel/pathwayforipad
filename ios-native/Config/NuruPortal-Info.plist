<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keep radio/session audio playing when the iPad locks or the app backgrounds.
	     Merged with the Xcode-generated Info.plist (GENERATE_INFOPLIST_FILE stays YES). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Radio Studio live mic — required for the on-mic broadcaster (MicBroadcaster). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Broadcast your microphone into Nuru Radio live broadcasts.</string>
</dict>
</plist>
