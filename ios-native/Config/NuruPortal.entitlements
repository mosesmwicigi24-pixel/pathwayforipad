<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst: SecItem* returns errSecMissingEntitlement without an
	     explicit keychain access group, so the session tokens silently failed
	     to persist on the Mac (login lost on every launch). The first group is
	     the app's own identifier — identical to the iOS default, so existing
	     iPad sessions are unaffected. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)org.nuruplace.portal</string>
	</array>
</dict>
</plist>
